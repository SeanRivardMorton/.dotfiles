theme=Tokyonight Night

# Comments start with a `#` and are only valid on their own line.
# Blank lines are ignored!

# keybind=ctrl+z=close_surface
# keybind=ctrl+d=new_split:right

# Empty values reset the configuration to the default value
font-family="Operator-caskabold"
font-size=16
font-feature=-liga
font-thicken=true

background-opacity=0.8
background-blur=40
title="VS Code"
shell-integration-features=no-title
macos-titlebar-proxy-icon=hidden

keybind = global:cmd+grave_accent=toggle_quick_terminal
keybind = ctrl+shift+up=scroll_page_up
keybind = ctrl+shift+down=scroll_page_down


